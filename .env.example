# .env.example
# Copy to .env.local and fill in real values.
# NEVER commit .env.local to Git.
# All VITE_ vars are validated at startup by env.ts and at build time by
# plugins/vite-plugin-env-check.ts — the app will not start with missing vars.

# ── Supabase ─────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── ABDM / NDHM ──────────────────────────────────────────────────────────────
# Production: https://healthid.ndhm.gov.in
# Sandbox:    https://healthidsbx.abdm.gov.in
VITE_ABDM_BASE_URL=https://healthidsbx.abdm.gov.in

# ── Runtime environment ───────────────────────────────────────────────────────
# Values: development | staging | production
VITE_ENVIRONMENT=development

# ── Sentry error monitoring ───────────────────────────────────────────────────
# Get DSN from https://sentry.io → Project Settings → Client Keys
# Leave blank in development to disable Sentry.
VITE_SENTRY_DSN=
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=mediward
SENTRY_AUTH_TOKEN=
