#!/usr/bin/env sh
# .husky/pre-push
# Runs before every `git push`. Blocks the push if:
#   1. There are unapplied local schema changes (you edited Supabase tables
#      in the dashboard but forgot to create a migration file), OR
#   2. TypeScript has type errors.
#
# Setup: pnpm add -D husky && npx husky init
# Make executable: chmod +x .husky/pre-push

set -e

echo "🔍 Pre-push checks..."

# ── 1. TypeScript gate ───────────────────────────────────────────────────────
echo "  ▸ TypeScript..."
pnpm typecheck
echo "  ✓ No type errors"

# ── 2. Supabase schema diff gate ────────────────────────────────────────────
# Generates a diff between the local migration history and the linked project.
# If the diff is non-empty, you have schema changes in the dashboard that are
# NOT captured in a migration file. Create one before pushing.
echo "  ▸ Checking for unapplied schema changes..."

SCHEMA_CHECK="skipped"

if ! command -v supabase > /dev/null 2>&1; then
  echo "  ⚠ supabase CLI not found — skipping schema diff check"
  echo "  Install: brew install supabase/tap/supabase"
else
  # Keep the diff (stdout) apart from errors (stderr), and record the exit
  # code. Previously `|| true` swallowed failures, so a diff that never ran
  # (no Docker, bad config.toml, project not linked) printed "✓ in sync".
  ERR_FILE=$(mktemp)
  if DIFF=$(supabase db diff 2>"$ERR_FILE"); then
    DIFF_OK=1
  else
    DIFF_OK=0
  fi

  if [ "$DIFF_OK" -eq 0 ]; then
    echo "  ⚠ Schema diff check could NOT run — schema sync is UNVERIFIED."
    echo "  supabase db diff failed with:"
    sed 's/^/    /' "$ERR_FILE" | tail -5
    echo "  Common causes: Docker not running, project not linked"
    echo "  (supabase link), or an outdated supabase/config.toml."
  # supabase db diff outputs SQL if there are differences, empty string if clean
  elif echo "$DIFF" | grep -qE "^(CREATE|ALTER|DROP|INSERT|UPDATE|DELETE)"; then
    echo ""
    echo "  ❌ PUSH BLOCKED: unapplied database schema changes detected."
    echo ""
    echo "  The following schema changes exist in your Supabase project but are"
    echo "  NOT captured in a migration file:"
    echo ""
    echo "$DIFF" | head -40
    echo ""
    echo "  Fix: create a migration file, then push:"
    echo "    supabase migration new <description>"
    echo "    # paste the diff SQL into the new file"
    echo "    git add supabase/migrations/ && git commit -m 'feat: add migration'"
    echo "    git push"
    echo ""
    rm -f "$ERR_FILE"
    exit 1
  else
    SCHEMA_CHECK="passed"
    echo "  ✓ Schema is in sync with migration history"
  fi
  rm -f "$ERR_FILE"
fi

echo ""
if [ "$SCHEMA_CHECK" = "passed" ]; then
  echo "✅ All pre-push checks passed."
else
  echo "✅ TypeScript passed. ⚠ Schema diff check was skipped — not verified."
fi