# android/keystore.properties.example
# Copy this to android/keystore.properties and fill in real values.
# keystore.properties is in .gitignore — NEVER commit it.
# In CI, the deploy-production.yml workflow writes this file from GitHub Secrets.

storeFile=mediward.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=mediward
keyPassword=YOUR_KEY_PASSWORD
